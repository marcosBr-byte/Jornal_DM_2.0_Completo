# Copy to .env for development. Never commit real secrets.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
# Informe a senha real do usuário PostgreSQL. Use aspas simples para senhas com # ou $.
PGPASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Somente em produção: descomente e configure as URLs abaixo.
# DATABASE_URL também sobrepõe o banco de desenvolvimento quando definida.
# DATABASE_URL=postgresql://postgres:password@localhost/jornal_dm_production
# CACHE_DATABASE_URL=postgresql://postgres:password@localhost/jornal_dm_production_cache
# QUEUE_DATABASE_URL=postgresql://postgres:password@localhost/jornal_dm_production_queue
# CABLE_DATABASE_URL=postgresql://postgres:password@localhost/jornal_dm_production_cable
APP_HOST=
SECRET_KEY_BASE=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
ACTIVE_STORAGE_SERVICE=local
AWS_REGION=us-east-1
S3_BUCKET=

# Render + Neon (definir no painel, não no .env de desenvolvimento):
# SINGLE_DATABASE=true
# ACTIVE_STORAGE_SERVICE=database
# RENDER_EXTERNAL_HOSTNAME é fornecido automaticamente pelo Render.

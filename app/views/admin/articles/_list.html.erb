<section id="managePanel" class="mb-5 scroll-mt-24 border border-[#e5ebf0] bg-white px-[27px] py-[25px] dark:border-[#2a4559] dark:bg-[#172f43] max-sm:px-4">
  <div class="mb-[23px] flex items-center justify-between gap-4 max-sm:flex-wrap">
    <div>
      <div class="flex items-center gap-[9px] text-[9px] font-extrabold tracking-[2px] text-[#64829b]"><span class="h-0.5 w-[22px] bg-[#6c96b2]"></span> CONTEÚDO DO PORTAL</div>
      <h2 class="mt-[7px] mb-1 font-display text-xl font-extrabold">Publicações recentes</h2>
      <p class="m-0 text-[10px] text-[#8a98a4] dark:text-[#9db0be]">Gerencie publicações e rascunhos antes de disponibilizá-los no portal.</p>
    </div>
    <span class="bg-[#edf3f7] px-[11px] py-[9px] text-[8px] font-extrabold tracking-[1px] text-[#64829b] dark:bg-[#213e55] dark:text-[#b9d0df]"><%= published_count %> publicadas · <%= draft_count %> rascunhos</span>
  </div>
  <div class="grid gap-[9px]">
    <% articles.each do |article| %>
      <div class="<%= class_names("flex items-center gap-[13px] border p-[11px] max-sm:flex-wrap", article.draft? ? "border-[#f0dfb8] bg-[#fffaf0] dark:border-[#655638] dark:bg-[#332d20]" : "border-[#e9eef2] dark:border-[#2a4559] dark:bg-[#142b3e]") %>">
        <div class="grid h-12 w-[58px] shrink-0 place-items-center overflow-hidden bg-[#edf3f7] font-display text-[15px] font-extrabold text-[#8ba4b6] dark:bg-[#203b50] [&>img]:size-full [&>img]:object-cover [&>div]:text-[15px]">
          <%= render "articles/image", article: article %>
        </div>
        <div class="min-w-0 flex-1">
          <b class="block truncate text-[11px]"><%= article.title %></b>
          <small class="<%= class_names("mt-[5px] block text-[8px]", article.draft? ? "text-[#a27a36] dark:text-[#d6b66d]" : "text-[#8d9aa5] dark:text-[#9db0be]") %>"><%= article.draft? ? "Rascunho" : "Publicada" %> · <%= article.category %></small>
        </div>
        <div class="flex flex-wrap gap-1.5 max-sm:w-full max-sm:justify-end">
          <%= link_to "Editar", edit_admin_article_path(article), class: "rounded-[2px] border border-[#e3eaf0] bg-white px-2.5 py-2 text-[8px] text-[#60798c] no-underline dark:border-[#385368] dark:bg-[#203b50] dark:text-[#d5e2ea]" %>
          <% if article.draft? %>
            <%= button_to "Publicar", publish_admin_article_path(article), method: :patch, class: "rounded-[2px] border border-[#e3eaf0] bg-white px-2.5 py-2 text-[8px] text-[#60798c] dark:border-[#385368] dark:bg-[#203b50] dark:text-[#d5e2ea]", form: { data: { turbo_confirm: "Publicar esta notícia no portal?" } } %>
          <% end %>
          <%= button_to "Excluir", admin_article_path(article), method: :delete, class: "rounded-[2px] border border-[#e3eaf0] bg-white px-2.5 py-2 text-[8px] text-[#b45e5e] dark:border-[#385368] dark:bg-[#203b50] dark:text-[#e09b9b]", form: { data: { turbo_confirm: "Excluir esta publicação permanentemente?" } } %>
        </div>
      </div>
    <% end %>
    <% if articles.empty? %><p class="p-6 text-center text-[10px] text-[#9aa7b1] dark:text-[#9db0be]">Nenhuma publicação cadastrada. Crie sua primeira notícia acima.</p><% end %>
  </div>
</section>
